{
  "name": "lighting-host-ui",
  "private": true,
  "version": "0.1.8",
  "description": "Lighting secondary display — one-click Windows portable app",
  "author": "Lighting",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win portable nsis",
    "electron:build:win": "npm run build && electron-builder --win portable nsis",
    "electron:build:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "app.lighting.display.ui",
    "productName": "Lighting副屏",
    "copyright": "Copyright © Lighting",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighting副屏",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "artifactName": "${productName}-${version}-安装包.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.exe"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "lighting-host.exe",
          "Lighting.apk"
        ]
      },
      {
        "from": "resources/vdd",
        "to": "vdd",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
