;
; LightingIdd.inf — Lighting Indirect Display Driver (IddCx / UMDF)
; Adapted from Microsoft Windows-driver-samples IndirectDisplay (MIT license).
;

[Version]
PnpLockdown = 1
Signature   = "$Windows NT$"
Class       = Display
ClassGUID   = {4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer    = 2.0
Provider    = %ManufacturerName%
CatalogFile = LightingIdd.cat
DriverVer   = 09/01/2026,0.1.12.0

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceName% = LightingIdd_Install, Root\LightingIdd

[SourceDisksFiles]
LightingIdd.dll = 1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[LightingIdd_Install.NT]
Include = WUDFRD.inf
Needs   = WUDFRD.NT
CopyFiles = UMDriverCopy

[LightingIdd_Install.NT.hw]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.HW
AddReg  = LightingIdd_HardwareDeviceSettings

[LightingIdd_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "LightingIddGroup"

[LightingIdd_Install.NT.Services]
Include = WUDFRD.inf
Needs   = WUDFRD.NT.Services

[LightingIdd_Install.NT.Wdf]
UmdfService     = LightingIdd,LightingIdd_ServiceInstall
UmdfServiceOrder = LightingIdd
UmdfKernelModeClientPolicy = AllowKernelModeClients

[LightingIdd_ServiceInstall]
UmdfLibraryVersion = 2.33.0
ServiceBinary = %12%\UMDF\LightingIdd.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy = 12,UMDF

[UMDriverCopy]
LightingIdd.dll

; =================== Strings ==================================

[Strings]
ManufacturerName = "Lighting"
DiskName         = "Lighting Indirect Display Driver"
DeviceName       = "Lighting Virtual Display (IddCx)"
REG_MULTI_SZ     = 0x00010000
REG_SZ           = 0x00000000
